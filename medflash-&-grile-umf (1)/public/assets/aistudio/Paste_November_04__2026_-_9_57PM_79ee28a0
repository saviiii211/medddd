        function updateStudyStatsAndCard() {

            const folder = getActiveFolder();

            if (!folder) return;

            const cards = folder.flashcards || [];



            const knownCount = cards.filter(c => c.status === 'known').length;

            const unknownCount = cards.filter(c => c.status === 'unknown').length;

            const unseenCount = cards.filter(c => !c.status || c.status === 'unseen').length;



            document.getElementById('knownCountLabel').textContent = knownCount;

            document.getElementById('unknownCountLabel').textContent = unknownCount;

            document.getElementById('unseenCountLabel').textContent = unseenCount;



            const emptyState = document.getElementById('emptyCardsState');

            const studyContainer = document.getElementById('swipeStudyContainer');

            const completedState = document.getElementById('deckCompletedState');



            if (cards.length === 0) {

                emptyState.classList.remove('hidden');

                studyContainer.classList.add('hidden');

                completedState.classList.add('hidden');

                return;

            }

            emptyState.classList.add('hidden');



            if (state.studyDeckIds.length === 0 || state.currentCardPointer >= state.studyDeckIds.length) {

                studyContainer.classList.add('hidden');

                completedState.classList.remove('hidden');

                document.getElementById('deckCompletedSubtitle').textContent = `Ai știut ${knownCount} carduri și mai ai ${unknownCount} marcate „Nu știu”.`;

                return;

            }



            completedState.classList.add('hidden');

            studyContainer.classList.remove('hidden');



            const currentId = state.studyDeckIds[state.currentCardPointer];

            const cardObj = cards.find(c => c.id === currentId);

            if (!cardObj) { rebuildStudyDeck(); return; }



            document.getElementById('currentCardIndexLabel').textContent = `Cardul ${state.currentCardPointer + 1} din ${state.studyDeckIds.length}`;

            document.getElementById('cardFrontText').textContent = cardObj.front;

            document.getElementById('cardBackText').textContent = cardObj.back;

            document.getElementById('cardCategoryTag').textContent = cardObj.category || folder.name;



            const inner3D = document.getElementById('flashcardInner3D');

            if (state.isCardFlipped) inner3D.classList.add('rotate-y-180');

            else inner3D.classList.remove('rotate-y-180');

        }



