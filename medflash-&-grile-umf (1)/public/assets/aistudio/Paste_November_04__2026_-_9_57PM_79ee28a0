            state.currentCardPointer = 0;

            state.isCardFlipped = false;

            updateStudyStatsAndCard();

            showToast('Cardurile au fost amestecate!', 'info');

        };



        window.resetFlashcardsProgress = async function() {

            const folder = getActiveFolder();

            if (!folder) return;

            folder.flashcards.forEach(c => c.status = 'unseen');

            state.studyOnlyUnknown = false;

            await persistFolderToCloud(folder);

            rebuildStudyDeck();

            showToast('Progres resetat!', 'info');

        };



        window.renderManageCardsList = function() {

            const folder = getActiveFolder();

            const listEl = document.getElementById('manageCardsList');

            if (!folder || !listEl) return;

            listEl.innerHTML = '';

            (folder.flashcards || []).forEach(card => {

                const row = document.createElement('div');

                row.className = 'bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-start justify-between gap-3';

                row.innerHTML = `<div class="space-y-1"><p class="text-sm font-bold text-slate-800">${escapeHtml(card.front)}</p><p class="text-xs text-slate-500">${escapeHtml(card.back)}</p></div><button onclick="deleteCard('${card.id}')" class="text-slate-400 hover:text-rose-600"><i class="fa-regular fa-trash-can"></i></button>`;

                listEl.appendChild(row);

            });

        };



        window.openCardModal = function() {

            state.editingCardId = null;

            document.getElementById('cardFrontInput').value = '';

            document.getElementById('cardBackInput').value = '';

            document.getElementById('cardTagInput').value = '';

            document.getElementById('cardModal').classList.remove('hidden');

        };



        window.closeCardModal = function() {

            document.getElementById('cardModal').classList.add('hidden');

        };



        window.saveCardForm = async function(e) {

            e.preventDefault();

            const folder = getActiveFolder();

            if (!folder) return;

            folder.flashcards.unshift({

                id: 'crd_' + Date.now(),

                front: document.getElementById('cardFrontInput').value.trim(),

                back: document.getElementById('cardBackInput').value.trim(),

                category: document.getElementById('cardTagInput').value.trim(),

                status: 'unseen'

            });

            await persistFolderToCloud(folder);

            closeCardModal();

            refreshActiveFolderUI(false);

            showToast('Card adăugat!', 'success');

        };



        window.deleteCard = async function(cardId) {

            const folder = getActiveFolder();

            if (!folder) return;

            folder.flashcards = folder.flashcards.filter(c => c.id !== cardId);

            await persistFolderToCloud(folder);

            refreshActiveFolderUI(false);

        };



        // TESTE GRILĂ ULTRA-RAPIDE ASINCRONE

        window.openGenerateTestModal = async function() {

            const folder = getActiveFolder();

            if (!folder) return;

            const txt = await ensureSourceTextLoaded(folder.id);

            if (!txt || txt.length < 30) {

                showToast('Încarcă un PDF în acest folder pentru a genera teste!', 'error');

                return;

            }

            document.getElementById('testTitleInput').value = `Test Admitere — ${folder.name}`;

            document.getElementById('generateTestModal').classList.remove('hidden');

        };



        window.closeGenerateTestModal = function() {

            document.getElementById('generateTestModal').classList.add('hidden');

        };



        window.startGeneratingTest = async function() {

            const folder = getActiveFolder();

            if (!folder) return;

            const sourceText = await ensureSourceTextLoaded(folder.id);

            const title = document.getElementById('testTitleInput').value.trim() || `Test — ${folder.name}`;

            const totalQ = parseInt(document.getElementById('testFormatSelect').value, 10) || 60;

            closeGenerateTestModal();



            showLoadingOverlay('Se generează testul...', 'Creăm primele întrebări în paralel...', 40);



            try {

                const chunk = getPdfChunkForBatch(sourceText, 0, 1, 15000);

                const schema = {

                    type: "ARRAY",

                    items: {

                        type: "OBJECT",

                        properties: {

                            "stem": { "type": "STRING" },

                            "optA": { "type": "STRING" },

                            "optB": { "type": "STRING" },

                            "optC": { "type": "STRING" },

                            "optD": { "type": "STRING" },

                            "optE": { "type": "STRING" },

                            "correctLetter": { "type": "STRING", "enum": ["A", "B", "C", "D", "E"] },

                            "explanation": { "type": "STRING" },

                            "sourceQuote": { "type": "STRING" }

                        },

                        required: ["stem", "optA", "optB", "optC", "optD", "optE", "correctLetter", "explanation", "sourceQuote"]

                    }

                };



                const csList = await callGeminiStructured(

                    "Ești profesor la UMFCD. Creează grile de complement simplu (A-E) fidele PDF-ului.",

                    `Generează 10 întrebări de complement simplu din acest text:\n${chunk}`,

                    schema

                );



                const questions = csList.map((q, idx) => ({

                    id: 'q_' + Date.now() + '_' + idx,

                    number: idx + 1,

                    type: 'CS',

                    stem: q.stem,

                    options: { A: q.optA, B: q.optB, C: q.optC, D: q.optD, E: q.optE },

                    correctLetter: (q.correctLetter || 'A').trim().toUpperCase(),

                    explanation: q.explanation,

                    sourceQuote: q.sourceQuote || '',

                    userChoice: null

                }));



                const newTest = {

                    id: 'tst_' + Date.now(),

                    ownerKey: state.profileKey,

                    folderId: folder.id,

                    title,

                    createdAt: Date.now(),

                    feedbackMode: 'instant',

                    completed: false,

                    questions

                };



                state.tests.unshift(newTest);

                await persistTestToCloud(newTest);



                hideLoadingOverlay();

                switchFolderTab('tests');

                refreshActiveFolderUI(false);

                openQuizPlayer(newTest.id);

                showToast('Testul a fost generat!', 'success');

            } catch (err) {

                console.error(err);

                hideLoadingOverlay();

                showToast('Eroare la generarea testului. Verifică cheia API în Setări.', 'error');

            }

        };



        window.renderSavedTestsList = function() {

            const folder = getActiveFolder();

            const listEl = document.getElementById('savedTestsList');

            if (!folder || !listEl) return;

            const folderTests = state.tests.filter(t => t.folderId === folder.id);

            listEl.innerHTML = '';



            if (folderTests.length === 0) {

                listEl.innerHTML = `<div class="bg-white rounded-2xl p-6 text-center text-slate-500 text-xs border border-slate-200">Niciun test în acest folder.</div>`;

                return;

            }



            folderTests.forEach(test => {

                const item = document.createElement('div');

                item.className = 'bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center justify-between gap-3';

                item.innerHTML = `<div><h4 class="font-bold text-slate-900">${escapeHtml(test.title)}</h4><p class="text-xs text-slate-500">${test.questions.length} întrebări</p></div><button onclick="openQuizPlayer('${test.id}')" class="py-2 px-4 rounded-xl bg-indigo-600 text-white font-bold text-xs">Deschide</button>`;

                listEl.appendChild(item);

            });

        };



        window.openQuizPlayer = function(testId) {

            state.activeTestId = testId;

            document.getElementById('testsListContainer').classList.add('hidden');

            document.getElementById('activeQuizPlayer').classList.remove('hidden');

            renderActiveQuiz();

        };



        window.closeActiveQuiz = function() {

            state.activeTestId = null;

            document.getElementById('activeQuizPlayer').classList.add('hidden');

            document.getElementById('testsListContainer').classList.remove('hidden');

            renderSavedTestsList();

        };



        function getActiveTest() { return state.tests.find(t => t.id === state.activeTestId) || null; }



        function renderActiveQuiz() {

            const test = getActiveTest();

            if (!test) return;

            document.getElementById('activeQuizTitle').textContent = test.title;

            const container = document.getElementById('quizQuestionsContainer');

            container.innerHTML = '';



            test.questions.forEach(q => {

                const card = document.createElement('div');

                card.className = 'bg-white rounded-2xl p-4 border border-slate-200 space-y-3';

                let optsHtml = '';

                ['A', 'B', 'C', 'D', 'E'].forEach(l => {

                    const isSelected = q.userChoice === l;

                    const isRight = q.correctLetter === l;

                    let style = 'bg-white border-slate-200';

                    if (test.completed || q.userChoice) {

                        if (isRight) style = 'bg-emerald-50 border-emerald-500 font-bold';

                        else if (isSelected) style = 'bg-rose-50 border-rose-500';

                    } else if (isSelected) {

                        style = 'bg-indigo-50 border-indigo-500 font-bold';

                    }

                    optsHtml += `<button onclick="selectQuizOption('${q.id}', '${l}')" class="w-full p-2.5 rounded-xl border text-left text-xs transition ${style}"><strong>${l}.</strong> ${escapeHtml(q.options[l])}</button>`;

                });

                card.innerHTML = `<span class="text-xs font-black">#${q.number}</span><p class="text-sm font-bold text-slate-900">${escapeHtml(q.stem)}</p><div class="space-y-1.5">${optsHtml}</div>${(test.completed || q.userChoice) ? `<div class="p-3 bg-slate-50 rounded-xl text-xs"><strong class="text-emerald-700">Răspuns corect: ${q.correctLetter}</strong><p class="mt-1">${escapeHtml(q.explanation)}</p></div>` : ''}`;

                container.appendChild(card);

            });

        }



        window.selectQuizOption = async function(qId, letter) {

            const test = getActiveTest();

            if (!test) return;

            const q = test.questions.find(item => item.id === qId);

            if (!q) return;

            q.userChoice = letter;

            renderActiveQuiz();

            await persistTestToCloud(test);

        };



        window.finishAndGradeQuiz = async function() {

            const test = getActiveTest();

            if (!test) return;

            test.completed = true;

            await persistTestToCloud(test);

            renderActiveQuiz();

            showToast('Test finalizat!', 'success');

        };



        window.deleteSavedTest = async function(testId) {

            state.tests = state.tests.filter(t => t.id !== testId);

            if (db) await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'medstudy_tests', testId));

            renderSavedTestsList();

        };



        // EXPORT / IMPORT BACKUP

        window.exportBackupJSON = function() {

            const data = { username: state.usernameDisplay, folders: state.folders, sources: state.sources, tests: state.tests };

            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });

            const url = URL.createObjectURL(blob);

            const a = document.createElement('a');

            a.href = url;

            a.download = `backup_${state.usernameDisplay || 'studii'}.json`;

            a.click();

        };



        window.triggerImportBackup = function() { document.getElementById('importJsonInput').click(); };

        window.handleImportBackup = async function(e) {

            const file = e.target.files?.[0];

            if (!file) return;

            const data = JSON.parse(await file.text());

            state.folders = data.folders || [];

            state.sources = data.sources || {};

            state.tests = data.tests || [];

            renderDashboard();

            showToast('Backup importat cu succes!', 'success');

        };



        window.openSettingsModal = function() { document.getElementById('settingsModal').classList.remove('hidden'); };

        window.closeSettingsModal = function() { document.getElementById('settingsModal').classList.add('hidden'); };

        window.saveSettingsModal = function() {

            state.customApiKey = document.getElementById('customApiKeyInput').value.trim();

            closeSettingsModal();

            showToast('Cheia API salvată!', 'success');

        };



        let confirmCb = null;

        function openConfirmModal(title, msg, cb) {

            document.getElementById('confirmModalTitle').textContent = title;

            document.getElementById('confirmModalMessage').textContent = msg;

            confirmCb = cb;

            document.getElementById('confirmModal').classList.remove('hidden');

        }

        window.closeConfirmModal = function() { document.getElementById('confirmModal').classList.add('hidden'); confirmCb = null; };

        document.getElementById('confirmModalActionBtn').onclick = () => { if (confirmCb) confirmCb(); closeConfirmModal(); };



        function showLoadingOverlay(t, s, p) {

            document.getElementById('loadingTitle').textContent = t;

            document.getElementById('loadingSubtitle').textContent = s;

            document.getElementById('loadingProgressBar').style.width = p + '%';

            document.getElementById('loadingOverlay').classList.remove('hidden');

        }

        function hideLoadingOverlay() { document.getElementById('loadingOverlay').classList.add('hidden'); }



        function showToast(msg, type = 'info') {

            const c = document.getElementById('toastContainer');

            const d = document.createElement('div');

            d.className = `px-4 py-3 rounded-2xl shadow-xl text-xs sm:text-sm font-semibold text-white ${type === 'success' ? 'bg-emerald-600' : type === 'error' ? 'bg-rose-600' : 'bg-slate-900'}`;

            d.textContent = msg;

            c.appendChild(d);

            setTimeout(() => d.remove(), 3500);

        }



        function escapeHtml(str) {

            return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

        }



        initCloudConnection();

    </script>

</body>

</html>