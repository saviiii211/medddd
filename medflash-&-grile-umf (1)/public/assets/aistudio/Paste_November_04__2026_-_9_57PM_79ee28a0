            const totalCount = parseInt(document.getElementById('genCardsCountSelect').value, 10) || 25;

            closeGenerateFlashcardsModal();



            showLoadingOverlay('Se generează flashcardurile...', 'AI-ul analizează textul PDF.', 30);



            const systemPrompt = `Ești profesor universitar la UMF Carol Davila. Creează flashcarduri fidele textului PDF furnizat, cu întrebare pe față (front) și răspuns exact pe verso (back).`;

            const schema = {

                type: "ARRAY",

                items: {

                    type: "OBJECT",

                    properties: {

                        "front": { "type": "STRING" },

                        "back": { "type": "STRING" },

                        "category": { "type": "STRING" }

                    },

                    required: ["front", "back", "category"]

                }

            };



            try {

                const chunk = getPdfChunkForBatch(sourceText, 0, 1, 20000);

                const list = await callGeminiStructured(systemPrompt, `Generează ${totalCount} flashcarduri din acest text:\n${chunk}`, schema);



                const newCards = list.map((item, idx) => ({

                    id: 'crd_' + Date.now() + '_' + idx,

                    front: item.front,

                    back: item.back,

                    category: item.category || folder.name,

                    status: 'unseen'

