
Conversația cu Gemini
<!DOCTYPE html>

<html lang="ro" class="h-full">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

    <title>MedFlash & Grile UMF — Studiu Inteligent din PDF</title>

    <!-- Tailwind CSS -->

    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <!-- PDF.js pentru extragerea fidelă a textului din PDF-uri -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>



    <script>

        tailwind.config = {

            darkMode: 'class',

            theme: {

                extend: {

                    fontFamily: {

                        sans: ['Inter', 'sans-serif'],

                        display: ['Plus Jakarta Sans', 'sans-serif'],

                    },

                    colors: {

                        med: {

                            50: '#f0fdfa',

                            100: '#ccfbf1',

                            200: '#99f6e4',

                            300: '#5eead4',

                            400: '#2dd4bf',

                            500: '#14b8a6',

                            600: '#0d9488',

                            700: '#0f766e',

                            800: '#115e59',

                            900: '#134e4a',

                        }

                    }

                }

            }

        }

    </script>



    <style>

        body {

            font-family: 'Inter', sans-serif;

            -webkit-tap-highlight-color: transparent;

            overscroll-behavior-y: contain;

        }

        .perspective-1000 { perspective: 1200px; }

        .transform-style-3d { transform-style: preserve-3d; transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1); }

        .backface-hidden { backface-visibility: hidden; -webkit-backface-visibility: hidden; }

        .rotate-y-180 { transform: rotateY(180deg); }

        .swipe-card { touch-action: pan-y; user-select: none; -webkit-user-select: none; transition: transform 0.25s ease, opacity 0.25s ease; }

        .swipe-card.dragging { transition: none; }

        ::-webkit-scrollbar { width: 6px; height: 6px; }

        ::-webkit-scrollbar-track { background: transparent; }

        ::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.4); border-radius: 9999px; }

    </style>

</head>

<body class="bg-slate-50 text-slate-900 min-h-full flex flex-col selection:bg-med-500 selection:text-white">



    <!-- TOAST NOTIFICATIONS -->

    <div id="toastContainer" class="fixed top-4 right-4 left-4 sm:left-auto sm:w-96 z-[100] flex flex-col gap-2 pointer-events-none"></div>



    <!-- ECRAN AUTENTIFICARE -->

    <div id="authScreen" class="fixed inset-0 z-50 bg-gradient-to-br from-slate-900 via-med-900 to-slate-900 flex items-center justify-center p-4 overflow-y-auto">

        <div class="bg-white/95 backdrop-blur-xl w-full max-w-md rounded-3xl shadow-2xl border border-white/20 p-6 sm:p-8 my-auto">

            <div class="flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-tr from-med-600 to-teal-400 text-white mx-auto mb-5 shadow-lg shadow-med-500/30">

                <i class="fa-solid fa-stethoscope text-2xl"></i>

            </div>

            <h1 class="text-2xl sm:text-3xl font-extrabold text-center text-slate-900 font-display tracking-tight">

                MedFlash & Grile UMF

            </h1>

            <p class="text-center text-slate-500 text-sm mt-2 mb-6">

                Introdu numele tău pentru a accesa folderele, flashcardurile și testele tale salvate.

            </p>



            <form id="loginForm" class="space-y-4">

                <div>

                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Numele tău de utilizator</label>

                    <div class="relative">

                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400">

                            <i class="fa-solid fa-user-doctor"></i>

                        </span>

                        <input

                            type="text"

                            id="usernameInput"

                            required

                            placeholder="ex: maria_umfcd"

                            class="w-full pl-11 pr-4 py-3.5 rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-med-500 focus:ring-4 focus:ring-med-500/15 outline-none font-medium text-slate-800"

                        >

                    </div>

                </div>



                <div>

                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">PIN / Cod secret (opțional)</label>

                    <div class="relative">

                        <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-slate-400">

                            <i class="fa-solid fa-lock"></i>

                        </span>

                        <input

                            type="password"

                            id="pinInput"

                            placeholder="ex: 1234 (sau lasă gol)"

                            class="w-full pl-11 pr-4 py-3.5 rounded-2xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-med-500 focus:ring-4 focus:ring-med-500/15 outline-none font-medium text-slate-800"

                        >

                    </div>

                </div>



                <button

                    type="submit"

                    id="loginBtn"

                    class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-med-600 to-teal-500 hover:from-med-700 hover:to-teal-600 text-white font-bold text-base shadow-lg shadow-med-600/25 active:scale-[0.99] transition flex items-center justify-center gap-2"

                >

                    <span>Intră în contul meu</span>

                    <i class="fa-solid fa-arrow-right"></i>

                </button>

            </form>



            <div class="mt-6 pt-5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">

                <button type="button" onclick="openSettingsModal()" class="text-med-700 hover:underline font-semibold flex items-center gap-1.5">

                    <i class="fa-solid fa-gear"></i> Setări API Netlify

                </button>

                <button type="button" onclick="triggerImportBackup()" class="text-slate-600 hover:underline font-semibold flex items-center gap-1.5">

                    <i class="fa-solid fa-file-import"></i> Importă Backup

                </button>

            </div>

        </div>

    </div>



    <!-- HEADER -->

    <header class="sticky top-0 z-30 bg-white/90 backdrop-blur-md border-b border-slate-200/80">

        <div class="max-w-5xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-2">

            <div class="flex items-center gap-2 min-w-0">

                <button

                    id="backToFoldersBtn"

                    onclick="navigateToDashboard()"

                    class="hidden items-center justify-center w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition shrink-0"

                >

                    <i class="fa-solid fa-chevron-left"></i>

                </button>

                <div onclick="navigateToDashboard()" class="flex items-center gap-2.5 cursor-pointer truncate">

                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-med-600 to-teal-400 text-white flex items-center justify-center shadow-sm shrink-0">

                        <i class="fa-solid fa-dna text-sm"></i>

                    </div>

                    <div class="truncate">

                        <span class="font-extrabold text-base sm:text-lg text-slate-900 font-display tracking-tight block leading-none truncate" id="headerTitle">

                            MedFlash UMF

                        </span>

                        <span id="syncStatusBadge" class="text-[11px] text-emerald-600 font-medium flex items-center gap-1 mt-0.5">

                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>

                            <span id="syncStatusText">Sincronizat</span>

                        </span>

                    </div>

                </div>

            </div>



            <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">

                <button onclick="exportBackupJSON()" class="p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center gap-1.5 transition">

                    <i class="fa-solid fa-download text-med-600"></i>

                    <span class="hidden md:inline">Backup</span>

                </button>

                <button onclick="openSettingsModal()" class="p-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center gap-1.5 transition">

                    <i class="fa-solid fa-sliders text-slate-600"></i>

                    <span class="hidden lg:inline">Setări AI</span>

                </button>

                <button onclick="switchUserAccount()" class="py-2 px-3 rounded-xl bg-med-50 hover:bg-med-100 text-med-800 border border-med-200 text-xs font-bold flex items-center gap-1.5 transition max-w-[140px] truncate">

                    <i class="fa-solid fa-circle-user text-med-600"></i>

                    <span id="currentUserBadge" class="truncate">Utilizator</span>

                </button>

            </div>

        </div>

    </header>



    <!-- MAIN -->

    <main class="flex-1 max-w-5xl w-full mx-auto px-3 sm:px-6 py-5 pb-24">

        <!-- VIEW 1: FOLDERE -->

        <section id="dashboardView" class="space-y-6">

            <div class="bg-gradient-to-r from-med-800 via-med-700 to-teal-700 rounded-3xl p-5 sm:p-7 text-white shadow-xl relative overflow-hidden">

                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">

                    <div class="space-y-1.5 max-w-xl">

                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 backdrop-blur-sm text-xs font-semibold">

                            <i class="fa-solid fa-graduation-cap"></i>

                            <span>Pregătire Admitere UMFCD</span>

                        </div>

                        <h2 class="text-xl sm:text-2xl font-extrabold font-display">Folderele tale de studiu</h2>

                        <p class="text-med-100 text-xs sm:text-sm leading-relaxed">Organizează capitolele, încarcă PDF-ul și generează carduri sau teste grilă rapide.</p>

                    </div>

                    <button onclick="openFolderModal()" class="py-3.5 px-5 rounded-2xl bg-white text-med-900 hover:bg-med-50 font-extrabold text-sm shadow-lg active:scale-95 transition flex items-center justify-center gap-2 shrink-0">

                        <i class="fa-solid fa-folder-plus text-med-600 text-base"></i>

                        <span>Folder Nou</span>

                    </button>

                </div>

            </div>



            <div class="grid grid-cols-3 gap-2.5 sm:gap-4">

                <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-200 shadow-sm flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl bg-med-50 text-med-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-folder-open"></i></div>

                    <div class="min-w-0"><div id="statTotalFolders" class="text-lg sm:text-2xl font-extrabold leading-tight">0</div><div class="text-[11px] text-slate-500 truncate">Foldere</div></div>

                </div>

                <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-200 shadow-sm flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-layer-group"></i></div>

                    <div class="min-w-0"><div id="statTotalCards" class="text-lg sm:text-2xl font-extrabold leading-tight">0</div><div class="text-[11px] text-slate-500 truncate">Carduri</div></div>

                </div>

                <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-200 shadow-sm flex items-center gap-3">

                    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0"><i class="fa-solid fa-list-check"></i></div>

                    <div class="min-w-0"><div id="statTotalTests" class="text-lg sm:text-2xl font-extrabold leading-tight">0</div><div class="text-[11px] text-slate-500 truncate">Teste</div></div>

                </div>

            </div>



            <div id="foldersGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>



            <div id="emptyFoldersState" class="hidden bg-white rounded-3xl border-2 border-dashed border-slate-200 p-8 text-center">

                <div class="w-16 h-16 rounded-2xl bg-med-50 text-med-600 flex items-center justify-center mx-auto mb-4 text-2xl"><i class="fa-solid fa-folder-plus"></i></div>

                <h3 class="text-lg font-bold text-slate-800">Nu ai creat niciun folder</h3>

                <p class="text-sm text-slate-500 max-w-md mx-auto mt-1 mb-5">Creează primul tău folder (ex: „Capitolul 1 - Celula”) pentru a începe.</p>

                <button onclick="openFolderModal()" class="py-3 px-5 rounded-2xl bg-med-600 hover:bg-med-700 text-white font-bold text-sm shadow-md transition inline-flex items-center gap-2">

                    <i class="fa-solid fa-plus"></i> Creează folder

                </button>

            </div>

        </section>



        <!-- VIEW 2: INTERIOR FOLDER -->

        <section id="folderDetailView" class="hidden space-y-5">

            <div class="bg-white rounded-3xl p-4 sm:p-6 border border-slate-200 shadow-sm space-y-4">

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">

                    <div class="min-w-0">

                        <div class="flex items-center gap-2">

                            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-med-100 text-med-800">Folder</span>

                            <h2 id="activeFolderTitle" class="text-xl sm:text-2xl font-extrabold text-slate-900 truncate">Folder</h2>

                            <button onclick="openRenameFolderModal()" class="text-slate-400 hover:text-med-600 p-1.5"><i class="fa-solid fa-pen text-xs"></i></button>

                        </div>

                        <p id="activeFolderPdfStatus" class="text-xs sm:text-sm text-slate-500 mt-1 flex items-center gap-1.5"><i class="fa-regular fa-file-pdf text-rose-500"></i><span>Niciun PDF încărcat</span></p>

                    </div>



                    <div class="flex flex-wrap items-center gap-2">

                        <label class="cursor-pointer py-2.5 px-4 rounded-2xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs sm:text-sm transition flex items-center gap-2">

                            <i class="fa-solid fa-file-pdf text-rose-600"></i>

                            <span id="uploadPdfBtnLabel">Încarcă PDF</span>

                            <input type="file" id="pdfFileInput" accept="application/pdf" class="hidden" onchange="handlePdfUpload(event)">

                        </label>

                        <button onclick="openSourceTextModal()" class="py-2.5 px-3.5 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs sm:text-sm transition flex items-center gap-1.5">

                            <i class="fa-solid fa-file-lines text-slate-500"></i><span>Text Sursă</span>

                        </button>

                    </div>

                </div>



                <div class="pt-3 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-3">

                    <button onclick="openGenerateFlashcardsModal()" class="p-3.5 rounded-2xl bg-gradient-to-r from-med-600 to-teal-500 hover:from-med-700 text-white font-bold text-sm shadow-md transition flex items-center justify-between">

                        <span class="flex items-center gap-2.5">

                            <span class="w-8 h-8 rounded-xl bg-white/20 flex items-center justify-center"><i class="fa-solid fa-wand-magic-sparkles"></i></span>

                            <span class="text-left"><span class="block leading-tight">Generează Flashcarduri</span><span class="block text-[11px] text-med-100 font-normal">Fidel textului PDF</span></span>

                        </span>

                        <i class="fa-solid fa-chevron-right text-xs opacity-80"></i>

                    </button>



                    <button onclick="openGenerateTestModal()" class="p-3.5 rounded-2xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 text-white font-bold text-sm shadow-md transition flex items-center justify-between">

                        <span class="flex items-center gap-2.5">

                            <span class="w-8 h-8 rounded-xl bg-white/20 flex items-center justify-center"><i class="fa-solid fa-graduation-cap"></i></span>

                            <span class="text-left"><span class="block leading-tight">Generează Test Grilă (60 Grile)</span><span class="block text-[11px] text-indigo-100 font-normal">30 Simplu + 30 Grupat (Asincron)</span></span>

                        </span>

                        <i class="fa-solid fa-chevron-right text-xs opacity-80"></i>

                    </button>

                </div>

            </div>



            <!-- TABS FOLDER -->

            <div class="flex bg-slate-200/70 p-1.5 rounded-2xl gap-1">

                <button id="tabBtnSwipe" onclick="switchFolderTab('swipe')" class="flex-1 py-2.5 px-3 rounded-xl font-bold text-xs sm:text-sm transition flex items-center justify-center gap-1.5 bg-white text-slate-900 shadow-sm">

                    <i class="fa-solid fa-clone text-med-600"></i><span>Învață (Swipe)</span><span id="badgeCountSwipe" class="px-2 py-0.5 text-[11px] rounded-full bg-med-100 text-med-800">0</span>

                </button>

                <button id="tabBtnManage" onclick="switchFolderTab('manage')" class="flex-1 py-2.5 px-3 rounded-xl font-bold text-xs sm:text-sm transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900">

                    <i class="fa-solid fa-pen-to-square text-amber-600"></i><span>Editează Carduri</span>

                </button>

                <button id="tabBtnTests" onclick="switchFolderTab('tests')" class="flex-1 py-2.5 px-3 rounded-xl font-bold text-xs sm:text-sm transition flex items-center justify-center gap-1.5 text-slate-600 hover:text-slate-900">

                    <i class="fa-solid fa-file-circle-check text-indigo-600"></i><span>Teste Grilă</span><span id="badgeCountTests" class="px-2 py-0.5 text-[11px] rounded-full bg-indigo-100 text-indigo-800">0</span>

                </button>

            </div>



            <!-- SUB-TAB 1: SWIPE -->

            <div id="subTabSwipe" class="space-y-4">

                <div class="bg-white rounded-2xl p-3.5 sm:p-4 border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-3">

                    <div class="flex items-center gap-3 sm:gap-5 text-xs sm:text-sm font-bold">

                        <span class="flex items-center gap-1.5 text-emerald-600"><i class="fa-solid fa-circle-check"></i><span>Știu: <strong id="knownCountLabel">0</strong></span></span>

                        <span class="flex items-center gap-1.5 text-rose-600"><i class="fa-solid fa-circle-xmark"></i><span>Nu știu: <strong id="unknownCountLabel">0</strong></span></span>

                        <span class="flex items-center gap-1.5 text-slate-500"><i class="fa-regular fa-clock"></i><span>Rămase: <strong id="unseenCountLabel">0</strong></span></span>

                    </div>



                    <div class="flex flex-wrap items-center gap-2">

                        <button id="filterUnknownBtn" onclick="toggleStudyOnlyUnknown()" class="py-1.5 px-3 rounded-xl border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-bold transition flex items-center gap-1.5">

                            <i class="fa-solid fa-rotate-left"></i><span id="filterUnknownBtnText">Reia doar „Nu știu”</span>

                        </button>

                        <button onclick="shuffleCurrentDeck()" class="py-1.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition"><i class="fa-solid fa-shuffle"></i> Amestecă</button>

                        <button onclick="resetFlashcardsProgress()" class="py-1.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-semibold transition">Reset</button>

                    </div>

                </div>



                <div id="swipeStudyContainer" class="max-w-xl mx-auto space-y-4">

                    <div class="flex items-center justify-between text-xs font-bold text-slate-500 px-1">

                        <span id="currentCardIndexLabel">Cardul 1 din 10</span>

                        <span id="currentCardStatusPill" class="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">Neparcurs</span>

                    </div>



                    <div class="relative h-[340px] sm:h-[380px] w-full perspective-1000 select-none">

                        <div id="swipeBadgeKnow" class="pointer-events-none opacity-0 transition-opacity absolute top-6 left-6 z-20 px-4 py-1.5 rounded-xl border-4 border-emerald-500 bg-emerald-500/10 text-emerald-600 font-black text-lg uppercase -rotate-12">ȘTIU ✅</div>

                        <div id="swipeBadgeDontKnow" class="pointer-events-none opacity-0 transition-opacity absolute top-6 right-6 z-20 px-4 py-1.5 rounded-xl border-4 border-rose-500 bg-rose-500/10 text-rose-600 font-black text-lg uppercase rotate-12">NU ȘTIU ❌</div>



                        <div id="flashcardSwipeWrapper" class="swipe-card w-full h-full cursor-pointer" onclick="flipCurrentCard()">

                            <div id="flashcardInner3D" class="w-full h-full relative transform-style-3d">

                                <div class="backface-hidden absolute inset-0 bg-white rounded-3xl border-2 border-slate-200 shadow-xl p-6 sm:p-8 flex flex-col justify-between">

                                    <div class="flex items-center justify-between text-xs font-bold text-med-600 uppercase">

                                        <span><i class="fa-solid fa-circle-question"></i> Întrebare / Concept</span>

                                        <button type="button" onclick="event.stopPropagation(); openEditCurrentCardModal()" class="p-2 text-slate-400 hover:text-med-600"><i class="fa-solid fa-pen"></i></button>

                                    </div>

                                    <div class="my-auto overflow-y-auto max-h-[210px] flex items-center justify-center">

                                        <p id="cardFrontText" class="text-base sm:text-xl font-bold text-slate-800 text-center leading-relaxed"></p>

                                    </div>

                                    <div class="text-center text-xs text-slate-400 pt-2 border-t border-slate-100"><i class="fa-solid fa-hand-pointer animate-bounce"></i> Atinge cardul pentru a vedea răspunsul</div>

                                </div>



                                <div class="backface-hidden rotate-y-180 absolute inset-0 bg-gradient-to-br from-med-900 to-slate-900 text-white rounded-3xl border-2 border-med-500/40 shadow-xl p-6 sm:p-8 flex flex-col justify-between">

                                    <div class="flex items-center justify-between text-xs font-bold text-med-300 uppercase">

                                        <span><i class="fa-solid fa-lightbulb"></i> Răspuns Exact (din PDF)</span>

                                        <button type="button" onclick="event.stopPropagation(); openEditCurrentCardModal()" class="p-2 text-slate-300 hover:text-white"><i class="fa-solid fa-pen"></i></button>

                                    </div>

                                    <div class="my-auto overflow-y-auto max-h-[200px] flex flex-col items-center justify-center gap-3">

                                        <p id="cardBackText" class="text-sm sm:text-lg font-semibold text-white text-center leading-relaxed"></p>

                                        <p id="cardCategoryTag" class="text-[11px] text-med-200 bg-white/10 px-3 py-1 rounded-full"></p>

                                    </div>

                                    <div class="text-center text-xs text-med-200/80 pt-2 border-t border-white/10"><i class="fa-solid fa-arrows-left-right"></i> Swipe stânga (Nu știu) sau dreapta (Știu)</div>

                                </div>

                            </div>

                        </div>

                    </div>



                    <div class="grid grid-cols-5 gap-2.5 items-center pt-1">

                        <button onclick="markCurrentCard('unknown')" class="col-span-2 py-4 rounded-2xl bg-rose-50 hover:bg-rose-100 text-rose-700 border-2 border-rose-200 font-extrabold text-sm transition flex items-center justify-center gap-2">

                            <i class="fa-solid fa-xmark text-lg"></i><span>Nu știu</span>

                        </button>

                        <button onclick="navigateCardDeck(-1)" class="col-span-1 py-4 rounded-2xl bg-white hover:bg-slate-100 text-slate-600 border border-slate-200 font-bold transition flex items-center justify-center">

                            <i class="fa-solid fa-rotate-left"></i>

                        </button>

