    <script type="module">

        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";

        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";

        import { getFirestore, doc, getDoc, setDoc, deleteDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";



        if (window.pdfjsLib) {

            window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

        }



        const state = {

            firebaseReady: false,

            authUser: null,

            profileKey: null,

            usernameDisplay: '',

            customApiKey: '',

            folders: [],

            sources: {},

            tests: [],

            activeFolderId: null,

            activeTab: 'swipe',

            studyOnlyUnknown: false,

            studyDeckIds: [],

            currentCardPointer: 0,

            isCardFlipped: false,

            editingCardId: null,

            editingFolderId: null,

            activeTestId: null,

            quizFilter: 'all'

        };



        let db = null;

        let auth = null;

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'medflash-umfcd-app';

        let unsubscribeFolders = null;

        let unsubscribeTests = null;



        async function initCloudConnection() {

            try {

                if (typeof __firebase_config !== 'undefined' && __firebase_config) {

                    const firebaseConfig = JSON.parse(__firebase_config);

                    const app = initializeApp(firebaseConfig);

                    auth = getAuth(app);

                    db = getFirestore(app);



                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {

                        await signInWithCustomToken(auth, __initial_auth_token);

                    } else {

                        await signInAnonymously(auth);

                    }



                    onAuthStateChanged(auth, (user) => {

                        state.authUser = user;

                        state.firebaseReady = !!user;

                        updateSyncBadge(state.firebaseReady ? 'cloud' : 'memory');

                    });

                } else {

                    updateSyncBadge('github');

                }

            } catch (err) {

                console.warn("Mod autonom:", err);

                updateSyncBadge('github');

            }

        }



        function updateSyncBadge(mode) {

            const dot = document.querySelector('#syncStatusBadge span:first-child');

            const txt = document.getElementById('syncStatusText');

            if (!dot || !txt) return;

            if (mode === 'cloud') {

                dot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block';

                txt.textContent = 'Sincronizat în Cloud';

            } else {

                dot.className = 'w-1.5 h-1.5 rounded-full bg-sky-500 inline-block';

                txt.textContent = 'Mod Local / Gata de Netlify';

            }

        }



        function normalizeProfileKey(username, pin) {

            const cleanUser = (username || '').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '_');

            const cleanPin = (pin || '').trim().replace(/[^a-zA-Z0-9]/g, '');

            return cleanPin ? `${cleanUser}__pin_${cleanPin}` : `${cleanUser}__nopin`;

        }



        document.getElementById('loginForm').addEventListener('submit', async (e) => {

            e.preventDefault();

            const rawUser = document.getElementById('usernameInput').value.trim();

            const rawPin = document.getElementById('pinInput').value.trim();

            if (!rawUser) {

                showToast('Introdu un nume de utilizator!', 'error');

                return;

            }



