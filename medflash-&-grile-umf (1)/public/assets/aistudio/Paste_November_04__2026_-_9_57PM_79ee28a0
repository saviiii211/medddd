        async function attachCloudListenersForProfile(profileKey) {

            if (!state.authUser || !db) return;

            if (unsubscribeFolders) unsubscribeFolders();

            if (unsubscribeTests) unsubscribeTests();



            try {

                const userDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'medstudy_users', profileKey);

                const userSnap = await getDoc(userDocRef);

                if (userSnap.exists() && userSnap.data().customApiKey) {

                    state.customApiKey = userSnap.data().customApiKey;

                    document.getElementById('customApiKeyInput').value = state.customApiKey;

                }

            } catch (e) { console.warn(e); }



            const foldersCol = collection(db, 'artifacts', appId, 'public', 'data', 'medstudy_folders');

            unsubscribeFolders = onSnapshot(foldersCol, (snapshot) => {

                const loadedFolders = [];

                snapshot.forEach((docSnap) => {

                    const data = docSnap.data();

                    if (data && data.ownerKey === profileKey) {

                        let parsedCards = [];

                        if (typeof data.flashcardsJson === 'string') {

                            try { parsedCards = JSON.parse(data.flashcardsJson); } catch (_) { parsedCards = []; }

                        }

                        loadedFolders.push({

                            id: docSnap.id,

                            ownerKey: data.ownerKey,

                            name: data.name || 'Folder',

                            description: data.description || '',

                            pdfName: data.pdfName || '',

                            pdfPageCount: data.pdfPageCount || 0,

                            createdAt: data.createdAt || 0,

                            flashcards: parsedCards

                        });

                    }

                });

                loadedFolders.sort((a, b) => b.createdAt - a.createdAt);

                state.folders = loadedFolders;

                if (state.activeFolderId) {

                    refreshActiveFolderUI(false);

                } else {

                    renderDashboard();

                }

            });



            const testsCol = collection(db, 'artifacts', appId, 'public', 'data', 'medstudy_tests');

            unsubscribeTests = onSnapshot(testsCol, (snapshot) => {

                const loadedTests = [];

                snapshot.forEach((docSnap) => {

                    const data = docSnap.data();

                    if (data && data.ownerKey === profileKey) {

                        let parsedQuestions = [];

                        if (typeof data.questionsJson === 'string') {

                            try { parsedQuestions = JSON.parse(data.questionsJson); } catch (_) { parsedQuestions = []; }

                        }

                        loadedTests.push({

                            id: docSnap.id,

                            ownerKey: data.ownerKey,

                            folderId: data.folderId,

                            title: data.title || 'Test',

                            createdAt: data.createdAt || 0,

                            feedbackMode: data.feedbackMode || 'instant',

                            completed: !!data.completed,

                            questions: parsedQuestions

                        });

                    }

                });

                loadedTests.sort((a, b) => b.createdAt - a.createdAt);

                state.tests = loadedTests;

                renderDashboardStats();

                if (state.activeFolderId) renderSavedTestsList();

            });

        }



